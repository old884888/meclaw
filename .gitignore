# ── 通用排除（子目录另有各自的 .gitignore）──

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/

# 本地配置与密钥
config.json
*.env
.env
secrets.json

# 运行时数据
data/
history/
groups/
downloads/
souls/*/memory/
*.sqlite
*.db

# 备份与缓存
*.bak
*.bak1
*.bak2
*.bak3
*.chk
.fastembed_cache/
.pytest_cache/
tests.bak-*/

# IDE / 编辑器
.vscode/
.idea/
.claude/settings.local.json
*.swp
*~

# 系统
Thumbs.db
Desktop.ini
.DS_Store
